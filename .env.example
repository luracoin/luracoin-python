# Template only: the CLI does not load .env files. Export these values in the
# shell before starting it. The CLI also accepts --network and --data-dir.
LURACOIN_NETWORK=testnet
LURACOIN_HOME=/path/to/private/luracoin-data

# Optional exact directory for one node. Do not reuse it across networks.
# Command-line --data-dir takes the same role for a single invocation.
# LURACOIN_DATA_DIR=/path/to/private/luracoin-data/testnet-node-a

# Redis is currently used for the transaction mempool.
LURACOIN_REDIS_HOST=127.0.0.1
LURACOIN_REDIS_PORT=6379

# Optional. When omitted, each network uses its own Redis database number.
# LURACOIN_REDIS_DB=1

# Optional P2P hardening limits (defaults shown). Failed sync addresses use an
# in-memory exponential cooldown. Pending relay work is bounded per peer/cycle.
# LURACOIN_SYNC_COOLDOWN_BASE=30
# LURACOIN_SYNC_COOLDOWN_MAX=900
# LURACOIN_SYNC_COOLDOWN_LIMIT=4096
# LURACOIN_PENDING_RELAY_LIMIT=1000
# LURACOIN_REPLAY_BATCH_SIZE=100
# LURACOIN_REPLAY_BUDGET_SECONDS=5

# Never put an RPC token or wallet seed in this file. The node creates a
# mode-0600 rpc.token inside the selected data directory.

# The public, read-only explorer API starts on loopback by default. Its
# OpenAPI document is available at /openapi.json and Swagger UI at /docs.
# LURACOIN_EXPLORER_API=true
# LURACOIN_EXPLORER_HOST=127.0.0.1
# LURACOIN_EXPLORER_PORT=18000

# The denormalized SQLite explorer index is deliberately opt-in and requires
# LURACOIN_EXPLORER_API=true. Enabling it creates and incrementally populates
# <data-dir>/explorer.sqlite3.
# LURACOIN_EXPLORER_INDEX=false
# LURACOIN_EXPLORER_DB=/path/to/explorer.sqlite3
# LURACOIN_EXPLORER_INDEX_INTERVAL=2
